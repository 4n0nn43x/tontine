# Copy to .env and fill. Never commit .env or keys/.
# --- network (ts/src/network.ts) ---
NEAR_RPC=https://rpc.testnet.fastnear.com
TENDER_ID=tender.your-account.testnet
TENDER_KEY=ed25519:...
JUDGE_ID=judge.your-account.testnet
JUDGE_KEY=ed25519:...
INFERENCE_PROVIDER_ID=inference.your-account.testnet
# Comma separated, one per firm (reused cyclically if fewer than strategies).
OWNER_IDS=o1.your-account.testnet,o2.your-account.testnet
OWNER_KEYS=ed25519:...,ed25519:...
KEYS_FILE=../keys/firms.json
# Payment: "intents" (mainnet, USDC held in intents.near) or "ft" (a NEP-141 token, e.g. on testnet)
PAYMENT=intents
INTENTS_CONTRACT=intents.near
# Native USDC on NEAR (ft_metadata checked 2026-10-30: USDC, 6 decimals)
INTENTS_TOKEN_ID=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
USDC_TOKEN=
MIN_BOND_USDC=1
SLASH_USDC=1
FLOOR_USDC=0.5
FIRM_BUDGET_USDC=2
EPOCH_SECS=3600
# --- NEAR AI Cloud (unset = replay from fixtures/llm.json) ---
NEARAI_API_KEY=
NEARAI_MODEL=openai/gpt-oss-120b
RECORD=0
# --- market.near.ai (unset = replay from fixtures/market-board.json) ---
MARKET_TOKEN=
MARKET_LIVE=0
